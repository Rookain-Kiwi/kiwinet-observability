# Stack de supervision — kiwinet-observability
# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais versionner le .env (il est ignoré par Git).

# Mot de passe du rôle PostgreSQL "grafana".
# Doit correspondre exactement à celui du rôle sur l'instance PostgreSQL
# (kiwinet-services).
GRAFANA_DB_PASSWORD=changeme

# Webhook Discord des alertes Grafana (SECRET : ne jamais l'afficher ni le versionner).
# Format : https://discord.com/api/webhooks/<identifiant>/<jeton>
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REMPLACER_PAR_LE_WEBHOOK

# Optionnel : adresse d'écoute de Node Exporter (réseau hôte).
# Défaut : 0.0.0.0:9100, filtré par ufw (voir README).
# NODE_EXPORTER_LISTEN=0.0.0.0:9100
